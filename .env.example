# Copy to backend/.env and repo-root .env.local (Next). Do not commit real secrets.

# Neon PostgreSQL — use asyncpg driver for SQLAlchemy:
#   In Neon Console → Connection string → copy URI, then replace
#   postgresql://  with  postgresql+asyncpg://
# Example:
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Backend: attach C++ Contribution-1 microbench to POST /api/benchmark/run (requires
# `pip install ./native_ext` from backend/). Docker image sets this on by default.
USE_NATIVE_ENGINE=true

# Next.js → FastAPI (local dev, or explicit browser-direct URL in any host)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional: WebSocket origin if it differs from NEXT_PUBLIC_API_BASE_URL (omit if same host).
# NEXT_PUBLIC_WS_BASE_URL=wss://your-api.example.com

# Vercel / same-origin proxy: when NEXT_PUBLIC_API_BASE_URL is unset and VERCEL=1 (automatic
# on Vercel), the UI calls /api/backend/... and Next.js forwards to this origin (server-only).
# Use your public FastAPI base, no path suffix, e.g. https://alphatest-api.up.railway.app
# BACKEND_URL=

# Optional: force same-origin proxy locally (set BACKEND_URL to http://127.0.0.1:8000)
# NEXT_PUBLIC_USE_API_PROXY=1

# FastAPI CORS (comma-separated). Required if you use NEXT_PUBLIC_API_BASE_URL to a
# different origin than the UI. Not required when using BACKEND_URL proxy on Vercel.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
