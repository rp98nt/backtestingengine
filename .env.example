# Copy to backend/.env (local API only) and/or repo-root .env.local (Next). Do not commit real secrets.
#
# Cloud-first (no local FastAPI): set DATABASE_URL + CORS on your API host (Render, etc.);
# on Vercel set BACKEND_URL + NEXT_PUBLIC_USE_API_PROXY=1 (and NEXT_PUBLIC_* for /live) — see doc/DEPLOY_INTEGRATION.md.

# Neon PostgreSQL — use asyncpg driver for SQLAlchemy:
#   In Neon Console → Connection string → copy URI, then replace
#   postgresql://  with  postgresql+asyncpg://
#   Strip ?sslmode=... and channel_binding=... if present — asyncpg rejects those query params;
#   TLS for *.neon.tech is enabled in backend/app/database.py (connect_args ssl=True).
# Example:
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxxx.region.aws.neon.tech/neondb
DATABASE_URL=

# Backend: attach C++ Contribution-1 microbench to POST /api/benchmark/run (requires
# `pip install ./native_ext` from backend/). Docker image sets this on by default.
USE_NATIVE_ENGINE=true

# Next.js → FastAPI: localhost for optional local dev; on Vercel use BACKEND_URL proxy
# (unset below) or set to your public API HTTPS origin for browser-direct + WebSocket.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=

# Optional: WebSocket origin if it differs from NEXT_PUBLIC_API_BASE_URL (omit if same host).
# NEXT_PUBLIC_WS_BASE_URL=wss://your-api.example.com

# Vercel (hosted UI + Render/Fly API): set server-only BACKEND_URL to your FastAPI HTTPS
# origin (no /api suffix). Set NEXT_PUBLIC_USE_API_PROXY=1 so the browser always uses
# same-origin /api/backend/... (avoids 127.0.0.1 if VERCEL is not inlined in the client).
# BACKEND_URL=https://your-api.onrender.com
# NEXT_PUBLIC_USE_API_PROXY=1

# Optional: force same-origin proxy for local next dev (set BACKEND_URL to http://127.0.0.1:8000)
# NEXT_PUBLIC_USE_API_PROXY=1

# FastAPI CORS (comma-separated). Required if you use NEXT_PUBLIC_API_BASE_URL to a
# different origin than the UI. Not required when using BACKEND_URL proxy on Vercel.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
