# Copy to backend/.env and repo-root .env.local (Next). Do not commit real secrets.

# Neon PostgreSQL — use asyncpg driver for SQLAlchemy:
#   In Neon Console → Connection string → copy URI, then replace
#   postgresql://  with  postgresql+asyncpg://
# Example:
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Next.js → FastAPI (local dev)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# FastAPI CORS (comma-separated). Add your Vercel deployment URL when you deploy the UI.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
